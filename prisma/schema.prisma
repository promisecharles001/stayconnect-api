generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  password           String
  firstName          String
  lastName           String
  phone              String?
  avatarUrl          String?
  roleId             String
  status             UserStatus          @default(PENDING_VERIFICATION)
  emailVerified      Boolean             @default(false)
  emailVerifiedAt    DateTime?
  phoneVerified      Boolean             @default(false)
  phoneVerifiedAt    DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  lastLoginAt        DateTime?
  hostSince          DateTime?
  hostBio            String?
  hostRating         Float?              @default(0)
  hostReviewCount    Int?                @default(0)
  visitorRating      Float?              @default(0)
  visitorReviewCount Int?                @default(0)
  pushToken          String?
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  // Saved payout destination, so a host doesn't retype it on every
  // withdrawal. Deliberately not in USER_SAFE_SELECT — these are returned
  // only to the owner, never in the admin user list or any public response.
  payoutBankName      String?
  payoutBankCode      String?
  payoutAccountNumber String?
  payoutAccountName   String?
  payoutUpdatedAt     DateTime?
  bookings           Booking[]           @relation("VisitorBookings")
  hostBookings       Booking[]           @relation("HostBookings")
  earnings           EarningsLedger[]
  kycVerification    KYCVerification?
  properties         Property[]
  role               Role                @relation(fields: [roleId], references: [id])
  withdrawalRequests WithdrawalRequest[]
  visitorConversations Conversation[]      @relation("VisitorConversations")
  hostConversations  Conversation[]      @relation("HostConversations")
  reviewsGiven       Review[]            @relation("VisitorReviews")
  reviewsReceived    Review[]            @relation("HostReviews")
  wishlist           WishlistItem[]

  @@index([email])
  @@index([roleId])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]

  @@map("roles")
}

model KYCVerification {
  id                 String          @id @default(uuid())
  userId             String          @unique
  documentType       KYCDocumentType
  documentNumber     String
  documentImageFront String
  documentImageBack  String?
  dateOfBirth        DateTime?
  address            String?
  city               String?
  state              String?
  country            String?         @default("Nigeria")
  status             KYCStatus       @default(PENDING)
  reviewedBy         String?
  reviewedAt         DateTime?
  reviewNotes        String?
  rejectionReason    String?
  selfieImage        String?
  selfieVerified     Boolean         @default(false)
  submittedAt        DateTime        @default(now())
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
  @@map("kyc_verifications")
}

model Property {
  id                String         @id @default(uuid())
  // Host-controlled: whether the listing is currently on the market. Kept
  // separate from `status`, which is the admin moderation decision — a host
  // must be able to take their own listing down without being able to
  // approve it, and an admin's SUSPENDED must not be undoable by toggling
  // availability back on.
  isAvailable       Boolean        @default(true)
  hostId            String
  title             String
  description       String
  propertyType      PropertyType
  address           String
  city              String
  state             String
  country           String         @default("Nigeria")
  postalCode        String?
  latitude          Float?
  longitude         Float?
  maxGuests         Int
  bedrooms          Int
  beds              Int
  bathrooms         Float
  amenities         String[]       @default([])
  houseRules        String?
  checkInTime       String         @default("14:00")
  checkOutTime      String         @default("11:00")
  basePricePerNight Decimal        @db.Decimal(10, 2)
  cleaningFee       Decimal?       @db.Decimal(10, 2)
  commissionPercent Decimal        @default(10.00) @db.Decimal(5, 2)
  status            PropertyStatus @default(DRAFT)
  images            String[]       @default([])
  averageRating     Float          @default(0)
  reviewCount       Int            @default(0)
  isInstantBook     Boolean        @default(false)
  minNights         Int            @default(1)
  maxNights         Int?
  reviewedBy        String?
  reviewedAt        DateTime?
  reviewNotes       String?
  rejectionReason   String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  publishedAt       DateTime?
  bookings          Booking[]
  conversations     Conversation[]
  reviews           Review[]
  wishlistedBy      WishlistItem[]
  host              User           @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@index([hostId])
  @@index([status])
  @@index([city])
  @@index([propertyType])
  @@index([basePricePerNight])
  @@index([createdAt])
  @@map("properties")
}

model Booking {
  id               String        @id @default(uuid())
  // The short code the visitor puts in their bank transfer description, and
  // what an admin searches to match a line on the statement to a booking.
  // Stored rather than derived so it can be queried.
  //
  // Nullable because this deploys with `prisma db push`, which cannot add a
  // required column to a table that already has rows. Existing bookings are
  // backfilled by the seed step that runs straight after, and every new
  // booking sets it on insert — so it is null only in the gap between those
  // two, and the service falls back to deriving it from the id regardless.
  reference        String?       @unique
  visitorId        String
  hostId           String
  propertyId       String
  startDate        DateTime
  endDate          DateTime
  totalAmount      Decimal       @db.Decimal(10, 2)
  commissionAmount Decimal       @db.Decimal(10, 2)
  status           BookingStatus @default(PENDING)
  paymentProof     String?
  paymentVerified  Boolean       @default(false)
  verifiedAt       DateTime?
  verifiedBy       String?
  // Escrow: payment is verified (held by admin) before funds are released to
  // the host or refunded to the visitor. Visitor contact with the host stays
  // hidden until escrowStatus reaches HELD (see bookings.service.ts).
  escrowStatus     EscrowStatus  @default(PENDING)
  fundsReleasedAt  DateTime?
  fundsReleasedBy  String?
  refundedAt       DateTime?
  refundedBy       String?
  refundAmount     Decimal?      @db.Decimal(10, 2)
  refundReason     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  visitor          User          @relation("VisitorBookings", fields: [visitorId], references: [id])
  host             User          @relation("HostBookings", fields: [hostId], references: [id])
  property         Property      @relation(fields: [propertyId], references: [id])
  review           Review?

  @@index([visitorId])
  @@index([hostId])
  @@index([propertyId])
  @@index([status])
  @@index([createdAt])
  @@index([escrowStatus])
  @@map("bookings")
}

enum EscrowStatus {
  PENDING
  HELD
  RELEASED
  REFUNDED
}

model EarningsLedger {
  id            String   @id @default(uuid())
  hostId        String
  amount        Decimal  @db.Decimal(10, 2)
  type          String
  description   String
  bookingId     String?
  balanceBefore Decimal  @db.Decimal(10, 2)
  balanceAfter  Decimal  @db.Decimal(10, 2)
  withdrawalId  String?
  createdAt     DateTime @default(now())
  host          User     @relation(fields: [hostId], references: [id])

  @@index([hostId])
  @@index([createdAt])
  @@map("earnings_ledger")
}

model WithdrawalRequest {
  id                String           @id @default(uuid())
  hostId            String
  amount            Decimal          @db.Decimal(10, 2)
  currency          String           @default("NGN")
  bankName          String
  bankCode          String
  accountNumber     String
  accountName       String
  status            WithdrawalStatus @default(PENDING)
  processedAt       DateTime?
  processedBy       String?
  transferReference String?
  transferReceipt   String?
  failureReason     String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  host              User             @relation(fields: [hostId], references: [id])

  @@index([hostId])
  @@index([status])
  @@index([createdAt])
  @@map("withdrawal_requests")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum KYCStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
}

enum KYCDocumentType {
  NIN_SLIP
  DRIVERS_LICENSE
  INTERNATIONAL_PASSPORT
  VOTERS_CARD
}

model WishlistItem {
  id         String   @id @default(uuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
  @@map("wishlist_items")
}

enum PropertyType {
  APARTMENT
  HOUSE
  VILLA
  CONDO
  STUDIO
  HOTEL
  RESORT
  VISITOR_HOUSE
  HOSTEL
  OTHER
}

enum PropertyStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
  INACTIVE
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model Conversation {
  id          String    @id @default(uuid())
  propertyId  String
  visitorId   String
  hostId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  visitor     User      @relation("VisitorConversations", fields: [visitorId], references: [id], onDelete: Cascade)
  host        User      @relation("HostConversations", fields: [hostId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@index([propertyId])
  @@index([visitorId])
  @@index([hostId])
  @@index([updatedAt])
  @@unique([propertyId, visitorId, hostId])
  @@map("conversations")
}

model Message {
  id                       String       @id @default(uuid())
  conversationId           String
  senderId                 String
  content                  String
  isRead                   Boolean      @default(false)
  readAt                   DateTime?
  // True if this message had contact info (phone/email/social handle)
  // stripped out before saving — lets admins audit repeat offenders.
  containsRedactedContact  Boolean      @default(false)
  createdAt                DateTime     @default(now())
  conversation             Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@map("messages")
}

model Review {
  id              String    @id @default(uuid())
  bookingId       String    @unique
  propertyId      String
  visitorId         String
  hostId          String
  rating          Int
  comment         String?
  hostResponse    String?
  hostRespondedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  booking         Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  property        Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  visitor           User      @relation("VisitorReviews", fields: [visitorId], references: [id], onDelete: Cascade)
  host            User      @relation("HostReviews", fields: [hostId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([visitorId])
  @@index([hostId])
  @@index([createdAt])
  @@map("reviews")
}
